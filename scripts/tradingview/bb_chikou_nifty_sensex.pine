//@version=6
indicator("BB + Chikou Signals | Nifty & Sensex", shorttitle="BB Chikou", overlay=true)

// Based on the supplied Part 3/10 summary. Numeric squeeze rules are configurable
// implementation choices. This is an indicator: levels are references, not orders.
string groupBands = "Bollinger Bands"
int bbLength = input.int(20, "SMA period", minval=2, maxval=500, group=groupBands)
float bbMult = input.float(2.0, "Standard deviations", minval=0.1, step=0.1, group=groupBands)

string groupChikou = "Chikou confirmation"
int chikouBars = input.int(26, "Displacement in bars", minval=1, maxval=500, group=groupChikou, tooltip="Current close is plotted this many bars back. Signals compare against price that many bars ago; no future data is used.")
string clearance = input.string("Full candle", "Price clearance", options=["Full candle", "Close only"], group=groupChikou, tooltip="Full candle: current close must be above the historical high for bull signals, or below its low for bear signals. Close only compares historical closes.")
bool showChikou = input.bool(true, "Show backward-shifted Chikou line", group=groupChikou)

string groupSignals = "Signals"
bool firstTouchOnly = input.bool(true, "Require first touch of a band", group=groupSignals, tooltip="Start a setup only when the preceding candle did not touch the same band. A setup can confirm only on the very next candle.")
bool useSession = input.bool(true, "Indian cash session only (09:15-15:30 IST)", group=groupSignals)
float rewardRisk = input.float(1.0, "Target / initial risk", minval=0.1, step=0.1, group=groupSignals)
bool showSetups = input.bool(false, "Show setup dots", group=groupSignals)
bool showLevels = input.bool(true, "Show latest signal entry / stop / target", group=groupSignals)

string groupSqueeze = "Optional squeeze filter"
bool useSqueeze = input.bool(false, "Require recent squeeze and expanding bands", group=groupSqueeze)
int squeezeLength = input.int(50, "Band-width average period", minval=5, maxval=500, group=groupSqueeze)
float squeezeRatio = input.float(0.8, "Squeeze: width / average width at most", minval=0.1, maxval=1.0, step=0.05, group=groupSqueeze)
int squeezeWindow = input.int(10, "Squeeze lookback before setup (bars)", minval=1, maxval=100, group=groupSqueeze)

// Population standard deviation matches the standard Bollinger calculation.
float basis = ta.sma(close, bbLength)
float deviation = bbMult * ta.stdev(close, bbLength)
float upper = basis + deviation
float lower = basis - deviation
float bandwidth = basis != 0 ? (upper - lower) / math.abs(basis) : na
float averageWidth = ta.sma(bandwidth, squeezeLength)
bool squeezed = not na(averageWidth) and averageWidth > 0 and bandwidth <= averageWidth * squeezeRatio
int barsSinceSqueeze = ta.barssince(squeezed)
bool squeezeReady = not useSqueeze or (not na(barsSinceSqueeze[1]) and barsSinceSqueeze[1] <= squeezeWindow and bandwidth > bandwidth[1])

// Fixed IST session is independent of chart display timezone. Both setup and
// confirmation must be inside it, and confirmation must finish by 15:30.
string indiaZone = "Asia/Kolkata"
int localDay = year(time, indiaZone) * 10000 + month(time, indiaZone) * 100 + dayofmonth(time, indiaZone)
bool newDay = bar_index > 0 and localDay != localDay[1]
int sessionEnd = timestamp(indiaZone, year(time, indiaZone), month(time, indiaZone), dayofmonth(time, indiaZone), 15, 30)
bool inCashSession = timeframe.isintraday and not na(time(timeframe.period, "0915-1530:23456", indiaZone)) and not na(time_close) and time_close <= sessionEnd
bool allowed = not useSession or inCashSession
bool adjacentBars = bar_index > 0 and not newDay and time == time_close[1]
bool historyReady = not na(basis[2]) and not na(high[chikouBars]) and not na(low[chikouBars])

bool upperTouch = not na(upper) and high >= upper
bool lowerTouch = not na(lower) and low <= lower
// Reject candles touching both outer bands: they offer no single direction.
bool longSetup = barstate.isconfirmed and allowed and historyReady and upperTouch and not lowerTouch and (not firstTouchOnly or not upperTouch[1])
bool shortSetup = barstate.isconfirmed and allowed and historyReady and lowerTouch and not upperTouch and (not firstTouchOnly or not lowerTouch[1])

float chikouUpperObstacle = clearance == "Full candle" ? high[chikouBars] : close[chikouBars]
float chikouLowerObstacle = clearance == "Full candle" ? low[chikouBars] : close[chikouBars]
bool chikouBull = historyReady and close > chikouUpperObstacle
bool chikouBear = historyReady and close < chikouLowerObstacle

// Evaluate on the CURRENT bar; [1] restricts each setup to its next candle.
// Confirm with a close beyond the setup extreme, never merely a wick break.
bool buySignal = barstate.isconfirmed and allowed and adjacentBars and historyReady and longSetup[1] and chikouBull and squeezeReady and close > high[1] and close > basis
bool sellSignal = barstate.isconfirmed and allowed and adjacentBars and historyReady and shortSetup[1] and chikouBear and squeezeReady and close < low[1] and close < basis

// Freeze the initial SMA stop at the signal; it is not a trailing stop.
// Latest-signal references persist until another signal or a new IST day.
var float latestEntry = na
var float latestStop = na
var float latestTarget = na
if barstate.isconfirmed
    if newDay
        latestEntry := na
        latestStop := na
        latestTarget := na
    if buySignal or sellSignal
        latestEntry := close
        latestStop := basis
        latestTarget := buySignal ? close + (close - basis) * rewardRisk : close - (basis - close) * rewardRisk

plot(basis, "BB middle / SMA", color=color.orange, linewidth=2)
pUpper = plot(upper, "BB upper", color=color.new(color.blue, 15))
pLower = plot(lower, "BB lower", color=color.new(color.blue, 15))
fill(pUpper, pLower, color=color.new(color.blue, 94), title="Band fill")
// Negative offset is for this visualization only. Signals are never backdated.
plot(showChikou and barstate.isconfirmed ? close : na, "Chikou (shifted back)", color=color.purple, linewidth=2, offset=-chikouBars)
bgcolor(useSqueeze and squeezed and barstate.isconfirmed ? color.new(color.yellow, 90) : na, title="Squeeze")
plotshape(showSetups and longSetup, title="Long setup", style=shape.circle, location=location.abovebar, color=color.new(color.green, 40), size=size.tiny)
plotshape(showSetups and shortSetup, title="Short setup", style=shape.circle, location=location.belowbar, color=color.new(color.red, 40), size=size.tiny)
plotshape(buySignal, title="Bull signal", text="BULL", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.small)
plotshape(sellSignal, title="Bear signal", text="BEAR", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.small)

// Circles avoid drawing diagonal connectors when the reference levels change.
plot(showLevels ? latestEntry : na, "Entry", color=color.blue, style=plot.style_circles, linewidth=2)
plot(showLevels ? latestStop : na, "Initial stop", color=color.red, style=plot.style_circles, linewidth=2)
plot(showLevels ? latestTarget : na, "Target", color=color.green, style=plot.style_circles, linewidth=2)

// Hidden signal-only values keep alerts useful even when visible levels are off.
plot(buySignal or sellSignal ? close : na, "Signal entry", display=display.none)
plot(buySignal or sellSignal ? basis : na, "Signal stop", display=display.none)
plot(buySignal or sellSignal ? latestTarget : na, "Signal target", display=display.none)
alertcondition(buySignal, title="BB Chikou BULL", message="BULL {{exchange}}:{{ticker}} | {{interval}} | Entry {{plot(\"Signal entry\")}} | Initial SL {{plot(\"Signal stop\")}} | Target {{plot(\"Signal target\")}} | Confirmed candle close")
alertcondition(sellSignal, title="BB Chikou BEAR", message="BEAR {{exchange}}:{{ticker}} | {{interval}} | Entry {{plot(\"Signal entry\")}} | Initial SL {{plot(\"Signal stop\")}} | Target {{plot(\"Signal target\")}} | Confirmed candle close")
