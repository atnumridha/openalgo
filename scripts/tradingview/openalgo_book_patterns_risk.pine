var BKState book=bk_state()
book.units:=BKUnits.new(unitsVerified,productKind,unitDefinition,accountCurrency,quoteCurrency,conversion,unitValue,quantityStep,lotSize,false)
bk_unitScope(book.units,unitsTicker,syminfo.tickerid,syminfo.type,syminfo.currency)
// varip is restricted to delivery provenance. No geometry, indicator, pivot, event or plan advances intrabar.
varip int deliveryBarrier=timenow
varip int lastTick=na
varip bool tickReady=false
bool standard=chart.is_standard
bool usable=standard and syminfo.mintick>0 and not na(time_close)
if barstate.isrealtime
    bool gap=not na(lastTick) and timenow-lastTick>config.staleQuoteSeconds*1000
    if not usable or gap or not tickReady
        deliveryBarrier:=math.max(deliveryBarrier,timenow)
    tickReady:=usable
    lastTick:=timenow
int observed=barstate.isrealtime?int(timenow/1000):int(time_close/1000)
int seconds=int(timeframe.in_seconds())
book.blockedThrough:=na(book.blockedThrough)?int(deliveryBarrier/1000):math.max(book.blockedThrough,int(deliveryBarrier/1000))
bk_step(book,config,open,high,low,close,volume,int(time/1000),int(time_close/1000),bar_index,syminfo.mintick,barstate.isconfirmed,usable,barstate.isrealtime,observed,syminfo.prefix+":"+syminfo.ticker,seconds)
if barstate.isrealtime and barstate.isconfirmed and usable and array.size(book.alerts)>0
    string message="OpenAlgo Book Patterns & Risk | "+syminfo.tickerid+" | "
    for item in book.alerts
        message+=item+"; "
    alert(message+"Closed price references only; no fills or profitability implied.",alert.freq_once_per_bar_close)
var array<line> ownedLines=array.new<line>()
var array<label> ownedLabels=array.new<label>()
var table guide=table.new(guidePosition,2,16,bgcolor=color.new(color.black,12),frame_color=color.new(color.gray,50),frame_width=1)
bk_ownedLine(array<line> handles,int t1,float y1,int t2,float y2,color shade,bool dotted=false) =>
    array.push(handles,line.new(t1,y1,t2,y2,xloc=xloc.bar_time,color=shade,width=1,style=dotted?line.style_dotted:line.style_solid,force_overlay=true))
    0
// Bound compact text without discarding its complete hover explanation.
bk_compact(string value,int limit=64) =>
    string single=str.replace_all(value,"\n"," · ")
    str.length(single)>limit?str.substring(single,0,limit-1)+"…":single
bk_cell(table panel,int row,string key,string value,color shade=color.white) =>
    table.cell(panel,0,row,key,text_color=color.silver,text_size=size.small,text_halign=text.align_left)
    table.cell(panel,1,row,fullGuide?value:bk_compact(value),text_color=shade,text_size=size.small,text_halign=text.align_left,tooltip=value)
    0
bk_filterText(bool enabled,bool available,bool pass,float value) =>
    (not enabled?"off":not available?"unavailable":pass?"pass":"fail")+" ["+(na(value)?"unset":str.tostring(value,"#.##"))+"]"
if barstate.islast
    for handle in ownedLines
        line.delete(handle)
    array.clear(ownedLines)
    for handle in ownedLabels
        label.delete(handle)
    array.clear(ownedLabels)
    array<BKSegment> contextTrends=bk_visibleTrends(book,config,bar_index,int(time/1000))
    for trend in contextTrends
        color shade=trend.role=="Support trend"?color.aqua:color.orange
        bk_ownedLine(ownedLines,trend.a.t*1000,trend.a.price,trend.b.t*1000,trend.b.price,shade)
        array.push(ownedLabels,label.new(trend.b.t*1000,trend.b.price,trend.role+" · context",xloc=xloc.bar_time,style=label.style_label_left,color=color.new(shade,80),textcolor=shade,size=size.tiny,force_overlay=true))
    array<BKEvent> visible=bk_visible(book,config,bar_index)
    array<int> captionTimes=array.new<int>()
    array<float> captionPrices=array.new<float>()
    for e in visible
        color shade=e.status==0?color.new(color.gray,20):e.side==1?color.new(color.lime,10):color.new(color.red,10)
        if e.kind==0
            int p=0
            while p+1<array.size(e.points)
                BKPoint a=array.get(e.points,p)
                BKPoint z=array.get(e.points,p+1)
                if a.role=="high" and z.role=="low"
                    int width=int(math.max(1,seconds)*1000/4)
                    int left=a.t*1000-width
                    int right=a.t*1000+width
                    bk_ownedLine(ownedLines,left,a.price,right,a.price,shade,e.status==0)
                    bk_ownedLine(ownedLines,left,z.price,right,z.price,shade,e.status==0)
                    bk_ownedLine(ownedLines,left,a.price,left,z.price,shade,e.status==0)
                    bk_ownedLine(ownedLines,right,a.price,right,z.price,shade,e.status==0)
                p+=2
        else
            for segment in e.segments
                bk_ownedLine(ownedLines,segment.a.t*1000,segment.a.price,segment.b.t*1000,segment.b.price,shade,e.status==0)
        BKPoint anchor=bk_captionAnchor(e)
        float labelY=bk_captionPrice(e,syminfo.mintick)
        float laneGap=math.max(syminfo.mintick*4,e.scale*0.25)*1.5
        for lane=0 to 7
            bool collision=false
            if array.size(captionTimes)>0
                for j=0 to array.size(captionTimes)-1
                    if math.abs(anchor.t-array.get(captionTimes,j))<=seconds*3 and math.abs(labelY-array.get(captionPrices,j))<laneGap
                        collision:=true
            if not collision
                break
            labelY+=(e.side==1?-1:1)*laneGap
        array.push(captionTimes,anchor.t)
        array.push(captionPrices,labelY)
        bk_ownedLine(ownedLines,anchor.t*1000,anchor.price,anchor.t*1000,labelY,shade,true)
        string caption=(e.status==0?"Pending ":"")+e.name+" · "+(e.side==1?"Long":e.side== -1?"Short":"Neutral")
        string tooltip="Photo(s) "+e.photos+"\n"+e.reason+"\nStop: "+e.stopMethod+"\nTarget: "+e.targetMethod+"\nRecognition is causal; outlines are formation candles.\n"+e.id
        array.push(ownedLabels,label.new(anchor.t*1000,labelY,caption,xloc=xloc.bar_time,style=e.side==1?label.style_label_up:label.style_label_down,color=color.new(shade,65),textcolor=color.white,size=size.tiny,tooltip=tooltip,force_overlay=true))
    if book.active
        for j=0 to 2
            float price=j==0?book.plan.entry:j==1?book.plan.stop:book.plan.target
            color shade=j==0?color.aqua:j==1?color.red:color.lime
            string name=j==0?"Entry reference":j==1?"SL reference":"Target reference"
            int end=na(time_close)?time:time_close
            bk_ownedLine(ownedLines,book.plan.createdTime*1000,price,end,price,shade)
            array.push(ownedLabels,label.new(end,price,name+" "+str.tostring(price,format.mintick),xloc=xloc.bar_time,style=label.style_label_left,color=color.new(shade,75),textcolor=color.white,size=size.small,force_overlay=true))
    table.clear(guide,0,0,1,15)
    if showGuide
        BKBar x=array.size(book.bars)>0?array.get(book.bars,array.size(book.bars)-1):na
        int direction=book.active?book.plan.side:1
        string availability=not standard?"Unsupported synthetic chart":barstate.isrealtime?"Received live updates":"Last-session / historical references"
        if not fullGuide
            bk_cell(guide,0,"Strategy / side",book.active?book.plan.name+" · "+(book.plan.side==1?"Long":"Short")+" · frozen":book.reason,book.active?color.white:color.yellow)
            bk_cell(guide,1,"Next","Trend "+bk_trendText(book.trend)+" · "+book.nextCondition)
            bk_cell(guide,2,"Entry / SL / target",book.active?str.tostring(book.plan.entry,format.mintick)+" / "+str.tostring(book.plan.stop,format.mintick)+" / "+str.tostring(book.plan.target,format.mintick):"— / — / —")
            bk_cell(guide,3,"RR / sizing",book.active?str.tostring(book.plan.rr,"#.##")+"R · "+(not na(book.plan.quantity)?str.tostring(book.plan.quantity)+" units":"Sizing unavailable: "+book.plan.sizeReason):"— · sizing awaits a qualified plan")
            bk_cell(guide,4,"Status · Details",availability+" · Settings → Full guide",usable?color.aqua:color.orange)
        else
            bk_cell(guide,0,"BOOK PATTERNS & RISK",availability,usable?color.aqua:color.orange)
            bk_cell(guide,1,"Pattern / decision",book.reason,book.active?color.white:color.yellow)
            bk_cell(guide,2,"Prior/current context",bk_contextText(book,config))
            bk_cell(guide,3,"Expected / next",book.active?(book.plan.side==1?"Long":"Short")+" | "+book.nextCondition:book.nextCondition)
            bk_cell(guide,4,"Invalidation",book.active?"SL "+str.tostring(book.plan.stop,format.mintick)+" | "+book.plan.stopMethod:"Pending stop breach, window expiry, changed geometry")
            bk_cell(guide,5,"Entry / SL / target",book.active?str.tostring(book.plan.entry,format.mintick)+" / "+str.tostring(book.plan.stop,format.mintick)+" / "+str.tostring(book.plan.target,format.mintick):"WAIT — no qualified reference plan")
            bk_cell(guide,6,"Target method / RR",book.active?book.plan.targetMethod+" · "+str.tostring(book.plan.rr,"#.##")+"R":"Minimum "+str.tostring(minimumRR)+"R; structural targets never stretched")
            bk_cell(guide,7,"RSI"+str.tostring(config.rsiPeriod)+" / MACD"+str.tostring(config.macdFast)+"/"+str.tostring(config.macdSlow)+"/"+str.tostring(config.macdSignal)+" / V"+str.tostring(config.volumePeriod),na(x)?"unavailable":bk_filterText(rsiFilter,not na(x.rsi),direction==1?x.rsi>50:x.rsi<50,x.rsi)+" | "+bk_filterText(macdFilter,not na(x.signal),direction==1?x.macd>x.signal:x.macd<x.signal,x.macd)+" | "+bk_filterText(volumeFilter,not na(x.vm) and x.v>0,x.v>=config.volumeExpansion*x.vm,x.v))
            bk_cell(guide,8,"Quantity / lots",book.active and not na(book.plan.quantity)?str.tostring(book.plan.quantity)+" units / "+str.tostring(book.plan.lots)+" lots":book.active?book.plan.sizeReason:"Unset until a qualified plan and verified ticker units")
            bk_cell(guide,9,"Risk reference",book.active and not na(book.plan.riskCash)?str.tostring(book.plan.riskCash,"#.##")+" "+accountCurrency+" · budget "+str.tostring(book.plan.budget,"#.##"):"Equity "+str.tostring(equity)+" · risk "+str.tostring(riskPercent)+"%")
            bk_cell(guide,10,"Forming progress",book.active and not barstate.isconfirmed?"Provisional distance SL "+str.tostring(math.abs(close-book.plan.stop),format.mintick)+" / target "+str.tostring(math.abs(close-book.plan.target),format.mintick):"Closed state only; touches are price references")
            bk_cell(guide,11,"Context only",book.observations==""?"No new cross/divergence/break annotation":book.observations)
            bk_cell(guide,12,"Local rules",gapPolicy=="continuous"?"Continuous-market local variant: explicit gaps relaxed":"Explicit previous-close/body gaps; source exceptions")
            bk_cell(guide,13,"Local planning",bk_planningText(config))
            bk_cell(guide,14,"Sizing scope",unitsTicker==syminfo.tickerid?"Verified units still require positive equity/value/step/FX":"Units unbound for "+syminfo.tickerid+". Margin/exposure not established")
            bk_cell(guide,15,book.active?"Qualified alternatives":"Qualified evidence / conflict",bk_decisionEvidence(book,4),book.opposite?color.orange:color.white)
